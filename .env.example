# PostgreSQL connection string (Neon, or any Postgres instance).
# Used by the Next.js app (via @neondatabase/serverless) and by the
# standalone seed.js / createadmin.js scripts (via pg).
DATABASE_URL=

# Groq API key — used server-side only for AI triage and SAR drafting.
GROQ_API_KEY=

# Secret used by NextAuth to sign session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Required in production deployments; NextAuth can usually infer this
# in local dev. Set to your deployed URL, e.g. https://your-app.vercel.app
NEXTAUTH_URL=

# Used only by createadmin.js, to create/reset one investigator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Used only by seed.js, to seed a demo investigator + demo cases.
# If unset, seed.js falls back to admin@vigil.local / ChangeMe123! —
# change these before using the seeded account for anything real.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
